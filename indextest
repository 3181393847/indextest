<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>你更适合年上还是年下？｜亲密关系心理测试</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --ink:#2b2540;
    --muted:#7c7593;
    --line:#e8e4f5;
    --up:#5b6cff;
    --down:#ff7a59;
    --card:#fff;
  }
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    background:linear-gradient(170deg,#f7f5ff 0%,#fff6f3 55%,#f2f7ff 100%);
    background-attachment:fixed;
    color:var(--ink);
    line-height:1.65;
    min-height:100vh;
    padding:28px 16px 72px;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:720px;margin:0 auto}

  /* ---------- 头部 ---------- */
  .hero{text-align:center;margin-bottom:24px}
  .hero .tag{
    display:inline-block;font-size:12px;letter-spacing:2px;
    color:#8a7dff;background:rgba(138,125,255,.1);
    padding:5px 14px;border-radius:999px;margin-bottom:14px;
  }
  .hero h1{
    font-size:27px;line-height:1.35;font-weight:800;letter-spacing:-.4px;
    background:linear-gradient(120deg,#5b6cff,#a06cff 50%,#ff7a59);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .hero p{font-size:13.5px;color:var(--muted);margin-top:10px}

  /* ---------- 说明卡 ---------- */
  .note{
    background:rgba(255,255,255,.78);
    border:1px solid var(--line);
    border-radius:16px;
    padding:16px 18px;
    font-size:13px;
    color:#5f5877;
    margin-bottom:18px;
    backdrop-filter:blur(6px);
  }
  .note b{color:var(--ink)}
  .note .scale-demo{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
  .note .scale-demo span{
    font-size:11.5px;padding:3px 9px;border-radius:8px;
    background:#f2efff;color:#7a6fd6;
  }

  /* ---------- 进度 ---------- */
  .progress-box{
    position:sticky;top:0;z-index:20;
    background:rgba(252,251,255,.9);
    backdrop-filter:blur(10px);
    border:1px solid var(--line);
    border-radius:16px;
    padding:12px 16px;
    margin-bottom:20px;
    box-shadow:0 4px 18px rgba(90,80,160,.06);
  }
  .progress-top{
    display:flex;justify-content:space-between;align-items:center;
    font-size:12.5px;color:var(--muted);margin-bottom:8px;
  }
  .progress-top b{color:var(--up);font-size:14px}
  .track{height:6px;border-radius:99px;background:#eae6f8;overflow:hidden}
  .fill{height:100%;width:0;border-radius:99px;transition:width .35s cubic-bezier(.4,0,.2,1)}
  .fill.up{background:linear-gradient(90deg,#5b6cff,#8a6cff)}
  .fill.down{background:linear-gradient(90deg,#ff9a6c,#ff7a59)}

  /* ---------- 题目 ---------- */
  .q{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:18px;
    padding:18px 18px 16px;
    margin-bottom:14px;
    box-shadow:0 3px 14px rgba(90,80,160,.045);
    transition:border-color .25s, box-shadow .25s;
  }
  .q.answered{border-color:#d8d2ff;box-shadow:0 4px 18px rgba(91,108,255,.09)}
  .q-text{
    font-size:15px;font-weight:600;line-height:1.6;
    display:flex;gap:10px;margin-bottom:14px;
  }
  .q-num{
    flex:none;width:22px;height:22px;border-radius:7px;
    background:#f0edff;color:#7d70e8;
    font-size:12px;font-weight:700;
    display:flex;align-items:center;justify-content:center;
    margin-top:2px;transition:.25s;
  }
  .q.answered .q-num{background:linear-gradient(135deg,#5b6cff,#8a6cff);color:#fff}

  .opts{display:flex;gap:6px}
  .opt{
    flex:1;min-width:0;
    display:flex;flex-direction:column;align-items:center;gap:3px;
    padding:9px 3px;
    border:1.5px solid var(--line);
    background:#fcfbff;
    border-radius:12px;
    cursor:pointer;
    font-family:inherit;
    transition:transform .15s, background .2s, border-color .2s, box-shadow .2s;
    -webkit-tap-highlight-color:transparent;
  }
  .opt .num{font-size:14px;font-weight:700;color:#bdb6d4;transition:.2s;line-height:1}
  .opt .lbl{font-size:10px;color:#9c95b3;white-space:nowrap;letter-spacing:-.3px;transition:.2s}
  .opt:hover{border-color:#c9c2ff;background:#f7f5ff}
  .opt:active{transform:scale(.97)}
  .opt.sel{
    background:linear-gradient(135deg,#5b6cff,#906cff);
    border-color:transparent;
    box-shadow:0 6px 16px rgba(91,108,255,.3);
  }
  .opt.sel .num,.opt.sel .lbl{color:#fff}

  /* ---------- 提交按钮 ---------- */
  .submit{
    width:100%;margin-top:22px;
    padding:16px;
    border:none;border-radius:16px;
    font-family:inherit;font-size:16px;font-weight:700;letter-spacing:1px;
    color:#fff;cursor:pointer;
    background:linear-gradient(135deg,#5b6cff,#a06cff 60%,#ff7a59);
    box-shadow:0 10px 26px rgba(120,90,255,.28);
    transition:transform .18s, box-shadow .18s, background .2s;
  }
  .submit:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 14px 32px rgba(120,90,255,.35)}
  .submit:active:not(:disabled){transform:translateY(0)}
  .submit:disabled{
    background:#ded9ee;color:#a9a2c0;box-shadow:none;cursor:not-allowed;
  }

  /* ---------- 结果 ---------- */
  #result{display:none}
  #result.show{display:block;animation:fadeUp .5s cubic-bezier(.2,.8,.3,1) both}
  @keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}

  .res-card{
    background:#fff;border:1px solid var(--line);border-radius:22px;
    padding:28px 22px;text-align:center;
    box-shadow:0 12px 40px rgba(90,80,160,.1);
    position:relative;overflow:hidden;
  }
  .res-card::before{
    content:"";position:absolute;inset:-60% -30% auto -30%;height:220px;
    background:radial-gradient(circle at 50% 0%,rgba(140,120,255,.16),transparent 70%);
    pointer-events:none;
  }
  .res-emoji{font-size:44px;line-height:1;margin-bottom:10px;position:relative}
  .res-badge{
    display:inline-block;font-size:12px;letter-spacing:1.5px;
    padding:5px 14px;border-radius:999px;margin-bottom:12px;position:relative;
  }
  .res-title{font-size:24px;font-weight:800;letter-spacing:-.3px;margin-bottom:6px;position:relative}
  .res-sub{font-size:13px;color:var(--muted);margin-bottom:18px;position:relative}

  .scores{margin:20px 0 4px;display:flex;flex-direction:column;gap:16px;text-align:left}
  .score-head{
    display:flex;justify-content:space-between;align-items:baseline;
    font-size:13px;color:var(--muted);margin-bottom:7px;
  }
  .score-head b{font-size:17px;font-weight:800}
  .up-c{color:var(--up)}
  .down-c{color:var(--down)}
  .diff-line{
    margin-top:20px;padding:13px;border-radius:14px;
    background:#f8f6ff;border:1px dashed #ddd6ff;
    font-size:13.5px;color:#6a6288;
  }
  .diff-line b{color:#5b4fd6;font-size:15px}

  /* 详细分析 */
  .analysis{
    margin-top:18px;
    background:rgba(255,255,255,.85);
    border:1px solid var(--line);
    border-radius:20px;
    padding:24px 22px;
  }
  .analysis h3{
    font-size:15px;margin-bottom:16px;color:var(--ink);
    display:flex;align-items:center;gap:8px;
  }
  .analysis h3::before{
    content:"";width:4px;height:16px;border-radius:3px;
    background:linear-gradient(#5b6cff,#ff7a59);
  }
  .ana-block{margin-bottom:20px}
  .ana-block:last-child{margin-bottom:0}
  .ana-block h4{
    font-size:13.5px;font-weight:700;color:#4a4270;
    margin-bottom:7px;display:flex;align-items:center;gap:7px;
  }
  .ana-block h4 .dot{
    width:7px;height:7px;border-radius:50%;flex:none;
  }
  .ana-block p{
    font-size:13.5px;color:#5f5877;line-height:1.85;
    padding-left:14px;
    border-left:2px solid #f0edff;
  }
  .ana-block p strong{color:var(--ink)}

  /* 通用提醒 */
  .tips{
    margin-top:18px;
    background:rgba(255,255,255,.85);
    border:1px solid var(--line);border-radius:20px;
    padding:22px 22px 16px;
  }
  .tips h3{
    font-size:14.5px;margin-bottom:14px;color:var(--ink);
    display:flex;align-items:center;gap:7px;
  }
  .tips h3::before{content:"";width:4px;height:15px;border-radius:3px;background:linear-gradient(#5b6cff,#ff7a59)}
  .tips li{
    list-style:none;font-size:13.5px;color:#5f5877;line-height:1.8;
    padding-left:22px;position:relative;margin-bottom:11px;
  }
  .tips li:last-child{margin-bottom:0}
  .tips li::before{
    content:"";position:absolute;left:6px;top:9px;
    width:6px;height:6px;border-radius:50%;
    background:linear-gradient(135deg,#5b6cff,#ff7a59);
  }
  .tips li b{color:var(--ink)}

  .actions{display:flex;gap:12px;margin-top:20px}
  .btn{
    flex:1;padding:15px;border-radius:15px;
    font-family:inherit;font-size:15px;font-weight:700;
    cursor:pointer;border:none;transition:.2s;
  }
  .btn-primary{
    color:#fff;background:linear-gradient(135deg,#5b6cff,#906cff);
    box-shadow:0 8px 22px rgba(110,90,255,.26);
  }
  .btn-primary:hover{transform:translateY(-2px)}
  .btn-ghost{background:#fff;color:#6a6288;border:1.5px solid var(--line)}
  .btn-ghost:hover{border-color:#c9c2ff;color:var(--up)}

  .foot{text-align:center;font-size:11.5px;color:#aca5c0;margin-top:26px;line-height:1.8}

  @media(max-width:480px){
    body{padding:20px 12px 56px}
    .hero h1{font-size:22px}
    .hero p{font-size:12.5px}
    .q{padding:16px 14px 14px;border-radius:16px}
    .q-text{font-size:14px}
    .opts{gap:5px}
    .opt{padding:8px 2px;border-radius:10px}
    .opt .num{font-size:13px}
    .opt .lbl{font-size:9px}
    .res-card{padding:24px 16px}
    .res-title{font-size:20px}
    .analysis{padding:20px 16px}
    .ana-block p{font-size:13px}
  }
</style>
</head>
<body>
<div class="wrap">

  <header class="hero">
    <span class="tag">亲密关系 · 自我探索</span>
    <h1>你更适合年上，还是年下？</h1>
    <p>20 道题，从心理学角度测你在关系里更习惯站在哪个心理位置</p>
  </header>

  <div class="note">
    <b>作答说明：</b>这里的「年上 / 年下」不只指实际年龄，更指关系中的心理位置——谁更像安全基地、谁更常照顾、谁更常引导、谁更掌握节奏。请按<b>第一直觉</b>作答，不要过度思考「应该怎样」。
    <div class="scale-demo">
      <span>1 完全不符合</span><span>2 比较不符合</span><span>3 一般 / 说不清</span><span>4 比较符合</span><span>5 非常符合</span>
    </div>
  </div>

  <div class="progress-box">
    <div class="progress-top">
      <span>已完成 <b id="doneNum">0</b> / 20</span>
      <span id="pctText">0%</span>
    </div>
    <div class="track"><div class="fill up" id="progressFill"></div></div>
  </div>

  <main id="quiz"></main>

  <button class="submit" id="submitBtn" disabled>查看我的结果</button>

  <section id="result"></section>

  <p class="foot">
    本测试仅用于自我探索与娱乐，不构成心理诊断。<br>
    真正的亲密关系质量，取决于依恋安全、平等与冲突修复能力，而非年龄差本身。
  </p>
</div>

<script>
/* ================= 题目数据（20题） ================= */
const QUESTIONS = [
  "当我焦虑不安时，我希望伴侣比我更沉稳，能先安抚我。",
  "当伴侣焦虑不安时，我更愿意先稳住他/她、安抚他/她。",
  "我容易被阅历丰富、生活稳定的人吸引。",
  "我容易被充满活力、愿意和我一起尝试新事物的人吸引。",
  "在重大决定上，我希望对方更有经验，能给我方向。",
  "在重大决定上，我愿意承担更多拍板和负责的角色。",
  "我享受在关系里偶尔做「被照顾、被引导」的一方。",
  "我享受在关系里做「照顾、引导、保护」的一方。",
  "冲突时，我希望对方先冷静下来，带我梳理问题。",
  "冲突时，我愿意先安抚对方，再慢慢讲道理。",
  "伴侣的稳定感会让我更容易信任和依赖。",
  "伴侣对我的依赖和需要，会让我觉得自己很重要、更投入。",
  "我希望伴侣像「安全基地」，我探索累了可以回去。",
  "我喜欢带对方体验新事物，分享我的资源和世界。",
  "年龄比我大、心理成熟的人，会让我更容易产生依恋。",
  "年龄比我小、但愿意和我一起成长的人，会让我更容易投入。",
  "我不介意伴侣在关系中拥有更多话语权，只要他/她可靠。",
  "我不介意在关系中拥有更多话语权，因为我愿意负责。",
  "对方情绪稳定、包容，比和我一样情绪化更吸引我。",
  "对方愿意听我引导、和我一起学习沟通，会让我更满意。"
];

const LABELS = ["完全不符合","比较不符合","一般","比较符合","非常符合"];

/* ================= 状态 ================= */
const answers = new Array(QUESTIONS.length).fill(null);

/* ================= 渲染题目 ================= */
const quizEl = document.getElementById('quiz');
const frag = document.createDocumentFragment();

QUESTIONS.forEach((text, i) => {
  const card = document.createElement('div');
  card.className = 'q';
  card.dataset.index = i;

  const qt = document.createElement('div');
  qt.className = 'q-text';
  qt.innerHTML = `<span class="q-num">${i + 1}</span><span>${text}</span>`;
  card.appendChild(qt);

  const opts = document.createElement('div');
  opts.className = 'opts';

  LABELS.forEach((label, vi) => {
    const value = vi + 1;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'opt';
    btn.dataset.value = value;
    btn.setAttribute('aria-label', `第${i + 1}题 得${value}分 ${label}`);
    btn.innerHTML = `<span class="num">${value}</span><span class="lbl">${label}</span>`;
    btn.addEventListener('click', () => selectOption(i, value, card, opts));
    opts.appendChild(btn);
  });

  card.appendChild(opts);
  frag.appendChild(card);
});
quizEl.appendChild(frag);

/* ================= 选择逻辑 ================= */
function selectOption(index, value, card, opts) {
  answers[index] = value;
  opts.querySelectorAll('.opt').forEach(b => {
    b.classList.toggle('sel', Number(b.dataset.value) === value);
  });
  card.classList.add('answered');
  updateProgress();
}

function updateProgress() {
  const done = answers.filter(v => v !== null).length;
  const total = QUESTIONS.length;
  const pct = Math.round(done / total * 100);

  document.getElementById('doneNum').textContent = done;
  document.getElementById('pctText').textContent = pct + '%';
  document.getElementById('progressFill').style.width = pct + '%';

  const btn = document.getElementById('submitBtn');
  btn.disabled = done < total;
  btn.textContent = done < total ? `还有 ${total - done} 题未作答` : '查看我的结果';
}

/* ================= 计分 ================= */
function calcResult() {
  let up = 0, down = 0;
  answers.forEach((v, i) => {
    if ((i + 1) % 2 === 1) up += v;   // 奇数题 → 年上
    else down += v;                    // 偶数题 → 年下
  });
  return { up, down, diff: up - down };
}

/* ================= 结果类型 ================= */
const TYPES = {
  up: {
    emoji: "🫂",
    badge: "年上倾向",
    color: "#5b6cff",
    bg: "rgba(91,108,255,.1)",
    title: "偏「年上型」",
    sub: "你更容易被稳定、成熟、能带领你的人吸引",
    blocks: [
      ["核心特征", "你更容易被年长、心理成熟、稳定、有经验、能带领你的人吸引。你在关系里更愿意做「被照顾、被引导、被接住」的一方。"],
      ["心理学解释", "从依恋理论看，你可能对<strong>安全基地</strong>有较强需求。你希望伴侣能承接你的情绪、提供方向感，让你在探索世界时有一个稳定的后方。这不一定代表你依赖，而是你更习惯在安全关系中放松自己。若依恋焦虑偏高，你可能会把「对方比我稳」当成安全感来源。"],
      ["关系优势", "你容易建立稳定、有结构的关系。对方的人生经验、资源积累、情绪稳定，能让你更快信任和投入。你也更愿意在可靠的人面前展现脆弱，这有助于深度亲密。"],
      ["潜在风险", "容易把「年龄大」误当成「心理成熟」，遇到控制型、说教型、爹味/妈味重的伴侣。长期下来，你可能失去部分自主性，甚至把决策权全部让渡出去。如果对方并不真正成熟，你会反复失望。"],
      ["适合你的伴侣", "情绪稳定、尊重你、能引导但不控制、愿意让你独立的人。关键不是年龄，而是他/她是否有边界感、共情力和修复冲突的能力。"],
      ["关系建议", "练习自我安抚，保留自己的决策权和社交圈。区分「被照顾」和「被控制」：真正的成熟是让你更有力量，而不是让你更离不开他/她。"]
    ]
  },
  down: {
    emoji: "🌱",
    badge: "年下倾向",
    color: "#ff7a59",
    bg: "rgba(255,122,89,.1)",
    title: "偏「年下型」",
    sub: "你更容易被有活力、愿意和你一起成长的人吸引",
    blocks: [
      ["核心特征", "你更容易被年轻、有活力、愿意跟你成长、需要你带领的人吸引。你在关系里更愿意做「照顾、引导、保护」的一方。"],
      ["心理学解释", "这可能和<strong>照顾者脚本</strong>有关。你通过被需要、保护对方、引导对方来确认自己的价值。若你习惯压抑自己的脆弱，关系里就容易变成「我负责稳，你负责需要我」。这背后可能是自我价值感与照顾行为绑定。"],
      ["关系优势", "关系有活力、有成就感。你愿意分享资源、经验和世界，能带对方成长。你也容易在关系中感到自己被需要、被重视。"],
      ["潜在风险", "容易陷入拯救者情结、过度负责、把伴侣当孩子养。长期照顾会耗竭，而对方可能习惯依赖，不愿承担同等责任。你也可能不敢表达自己的脆弱，因为怕破坏「强者」形象。"],
      ["适合你的伴侣", "愿意成长、心理成熟、能互惠、不把你当父母或导师的人。年龄小没关系，但责任感、边界感、共情力不能少。"],
      ["关系建议", "允许自己脆弱，练习说「这次我也需要你」。不要用照顾换取爱，也不要把对方的成长当成自己的责任。健康关系是互相照顾，不是单向养育。"]
    ]
  },
  flex: {
    emoji: "⚖️",
    badge: "灵活平衡型",
    color: "#8a6cff",
    bg: "rgba(138,108,255,.1)",
    title: "灵活平衡型",
    sub: "年龄差不是关键，互动质量才是",
    blocks: [
      ["核心特征", "年龄差对你不是关键。你更看重价值观、沟通方式、依恋安全感、生活节奏和心理成熟度。你可以在不同阶段切换「被照顾」或「照顾者」角色。"],
      ["心理学解释", "你的关系偏好更接近<strong>匹配模型</strong>：你重视的是互动质量，而不是固定角色。你可能具有较好的自我分化能力，能在亲密中保持自我，也能在需要时依靠对方。"],
      ["关系优势", "适应性强，不容易被年龄脚本限制。你能根据情境和对方特点调整角色，关系弹性较好。"],
      ["潜在风险", "有时可能忽视隐性权力动态。比如你以为自己不在意年龄，但实际相处中仍可能被对方的资源、阅历或情绪稳定性影响。也可能因为「怎样都行」而忽略自己的真实需求。"],
      ["适合你的伴侣", "安全型依恋、沟通直接、愿意共同协商的人。年龄不是重点，重点是双方能否平等对话。"],
      ["关系建议", "定期讨论关系分工：谁更常做决策？谁更常安抚？谁更常承担现实责任？把隐性规则说出来，关系会更稳。"]
    ]
  },
  both: {
    emoji: "🔁",
    badge: "双向灵活型",
    color: "#5b6cff",
    bg: "rgba(91,108,255,.1)",
    title: "双向灵活型",
    sub: "你既能被带领，也能承担带领角色",
    blocks: [
      ["核心特征", "你既能享受被带领，也能承担带领角色。你在关系里角色弹性很大，谁有经验谁主导，谁脆弱谁被接住。"],
      ["心理学解释", "你可能同时具备<strong>安全基地需求</strong>和<strong>照顾者能力</strong>。你既能依赖，也能被依赖。这种弹性通常来自较好的依恋安全感，或者你在不同关系中习得了多种角色。"],
      ["关系优势", "适应力强，能配合不同伴侣。关系不容易僵化，遇到压力时也能灵活调整。你既能给予，也能接受。"],
      ["潜在风险", "角色可能混乱，或者你过度承担。因为「我什么都能做」，容易变成关系里的全能者，最后疲惫不堪。也可能让对方不知道何时该站出来。"],
      ["适合你的伴侣", "同样有弹性、愿意沟通、能主动承担的人。最好双方都能明确表达「这次我需要你」或「这次我来」。"],
      ["关系建议", "不要长期固定成「一个人永远照顾另一个人」。定期检查付出与回报是否平衡。你的弹性是优势，但边界同样重要。"]
