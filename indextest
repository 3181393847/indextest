      ["关系建议", "关注实际互动，而不是标签。问问自己：在这段关系里，我是否被尊重？我是否能表达脆弱？我们是否能一起修复冲突？"]
    ]
  }
};

/* ================= 渲染结果 ================= */
function renderResult() {
  const { up, down, diff } = calcResult();

  let key;
  if (up >= 40 && down >= 40) key = 'both';
  else if (up <= 20 && down <= 20) key = 'low';
  else if (diff >= 8) key = 'up';
  else if (diff <= -8) key = 'down';
  else key = 'flex';

  const r = TYPES[key];
  const upPct = Math.min(100, up / 50 * 100);
  const downPct = Math.min(100, down / 50 * 100);
  const diffText = diff > 0 ? `+${diff}` : `${diff}`;

  const blocksHtml = r.blocks.map(([h, p]) => `
    <div class="ana-block">
      <h4><span class="dot" style="background:${r.color}"></span>${h}</h4>
      <p>${p}</p>
    </div>
  `).join('');

  const resultEl = document.getElementById('result');
  resultEl.innerHTML = `
    <div class="res-card">
      <div class="res-emoji">${r.emoji}</div>
      <div class="res-badge" style="color:${r.color};background:${r.bg}">${r.badge}</div>
      <h2 class="res-title">${r.title}</h2>
      <p class="res-sub">${r.sub}</p>

      <div class="scores">
        <div>
          <div class="score-head">
            <span>年上倾向分</span>
            <span><b class="up-c">${up}</b> / 50</span>
          </div>
          <div class="track"><div class="fill up" id="barUp" style="width:0%"></div></div>
        </div>
        <div>
          <div class="score-head">
            <span>年下倾向分</span>
            <span><b class="down-c">${down}</b> / 50</span>
          </div>
          <div class="track"><div class="fill down" id="barDown" style="width:0%"></div></div>
        </div>
      </div>

      <div class="diff-line">
        差值（年上 − 年下）＝ <b>${diffText}</b>
      </div>
    </div>

    <div class="analysis">
      <h3>详细分析</h3>
      ${blocksHtml}
    </div>

    <div class="tips">
      <h3>心理学提醒</h3>
      <ul>
        <li><b>年上 ≠ 成熟，年下 ≠ 幼稚。</b>心理成熟包括：情绪调节、责任承担、边界感、共情、冲突修复能力。</li>
        <li><b>偏好不是命运。</b>你会被某种关系动力吸引，但真正决定关系质量的，是双方是否安全依恋、是否平等、是否能修复冲突。</li>
        <li><b>警惕极端脚本。</b>年上型要警惕「爹味 / 妈味控制」；年下型要警惕「拯救者—依赖者」循环。</li>
        <li><b>最好和伴侣一起讨论。</b>你们可以分别测一次，然后聊聊：谁更常做决策？谁更常安抚？谁更常承担现实责任？这比年龄差本身更重要。</li>
        <li><b>结果可以变化。</b>随着经历、成长和依恋模式改变，你的偏好也可能变化。测试结果只是此刻的一面镜子。</li>
      </ul>
    </div>

    <div class="actions">
      <button class="btn btn-primary" id="againBtn">重新测一次</button>
      <button class="btn btn-ghost" id="topBtn">回到顶部改答案</button>
    </div>
  `;

  resultEl.classList.add('show');

  requestAnimationFrame(() => {
    setTimeout(() => {
      const bu = document.getElementById('barUp');
      const bd = document.getElementById('barDown');
      if (bu) bu.style.width = upPct + '%';
      if (bd) bd.style.width = downPct + '%';
    }, 120);
  });

  document.getElementById('againBtn').addEventListener('click', resetAll);
  document.getElementById('topBtn').addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

/* ================= 重置 ================= */
function resetAll() {
  answers.fill(null);
  document.querySelectorAll('.q').forEach(card => {
    card.classList.remove('answered');
    card.querySelectorAll('.opt').forEach(b => b.classList.remove('sel'));
  });
  document.getElementById('result').classList.remove('show');
  document.getElementById('result').innerHTML = '';
  updateProgress();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ================= 绑定 ================= */
document.getElementById('submitBtn').addEventListener('click', () => {
  if (answers.includes(null)) return;
  renderResult();
});

updateProgress();
</script>
</body>
